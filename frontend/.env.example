# Google Maps Platform Configuration
# Get your API key from https://console.cloud.google.com/google/maps-apis/credentials
# Or get a free demo key from https://mapsplatform.google.com/maps-demo-key
VITE_GOOGLE_MAPS_API_KEY=

# Map ID required for Advanced Markers (Default: DEMO_MAP_ID)
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
